	measure 'Cor (background)' = ```
			
			VAR _ordem =
			    SELECTEDVALUE(parametro_metricas[parametro_meta Order])
			
			VAR _Valor =
			    SWITCH(
			        _ordem,
			        0,  [Total de Escolas],
			        1,  [Qtd. de alunos projetados no EM Noturno],
			        2,  [Qtd. de alunos projetados no PEI],
			        3,  [Qtd. de salas de aula nas escolas existentes],
			        4,  [% matrículas pendentes],
			        5,  [Demanda e coleta: qualidade do enturmamento],
			        6,  [Rendimento: turmas lançadas dentro do prazo],
			        7,  [Fechamento: turmas lançadas dentro do prazo],
			        8,  [Bolsa Família: % de não informados],
			        9,  [Censo Escolar: % de divergências na matrícula],
			        10, [Censo Escolar: % de divergência na taxa de aprovação],
			        11, [Cadastro de Escolas: % de cadastros inválidos],
			        12, [Cadastro de Alunos: % de cadastros inválidos]
			    )
			    
			VAR _Tipo =
			    LOOKUPVALUE(
			        'Regras Indicadores'[Tipo],
			        'Regras Indicadores'[Indicador], _ordem
			    )
			
			VAR _Meta =
			    SWITCH(
			        _ordem,
			        0,  SELECTEDVALUE(excelencia_objetivo[escolas]),
			        1,  SELECTEDVALUE(excelencia_objetivo[alunos_noturnos]),
			        2,  SELECTEDVALUE(excelencia_objetivo[alunos_pei]),
			        3,  SELECTEDVALUE(excelencia_objetivo[salas_aula]),
			        4,  SELECTEDVALUE(excelencia_objetivo[alunos_pendentes]),
			        5,  SELECTEDVALUE(excelencia_objetivo[qualidade_entur]),
			        6,  SELECTEDVALUE(excelencia_objetivo[rendimento]),
			        7,  SELECTEDVALUE(excelencia_objetivo[fechamento]),
			        8,  SELECTEDVALUE(excelencia_objetivo[bolsa_percent_nao_informado]),
			        9,  SELECTEDVALUE(excelencia_objetivo[diverg_matricula]),
			        10, SELECTEDVALUE(excelencia_objetivo[diverg_rendimento]),
			        11, SELECTEDVALUE(excelencia_objetivo[cadastro_escola]),
			        12, SELECTEDVALUE(excelencia_objetivo[cadastro_aluno])
			    )
			
			VAR _Atingimento =
			    SWITCH(
			        TRUE(),
			        _Tipo = "MAIOR", DIVIDE(_Valor, _Meta),
			        _Tipo = "MENOR", DIVIDE(_Meta, _Valor)
			    )
			
			RETURN
			    IF(
			        ISINSCOPE(excelencias[NM_ESCOLA]),
			        BLANK(),
			        SWITCH(
			            TRUE(),
			            ISBLANK(_Valor) || ISBLANK(_Meta), BLANK(),
			            _Atingimento >= 1,   "#E7F4E5",
			            _Atingimento >= 0.6, "#FDFCD9",
			            "#F1DEDC"
			        )
			    )
			```
		displayFolder: Formatação\Cores
		lineageTag: 5abec436-8817-4fbd-bec2-54f55b4fb74b

