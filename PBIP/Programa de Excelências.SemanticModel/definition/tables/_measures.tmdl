	measure 'Demanda e coleta: qualidade do enturmamento' = ```
			
			VAR _saldo = 
			    SUM(excelencias[SALDO_AMPLIAR]) + SUM(excelencias[SALDO_ADEQUAR]) 
			
			VAR _turm = 
			    SUM(excelencias[QTD_TURMAS_COLETA])
			
			RETURN
			    DIVIDE(
			        _saldo,
			        _turm,
			        0
			    )
			
			```
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Métricas\Matrícula e Vida Escolar
		lineageTag: 103eace6-5356-42ee-bcc4-3757348b8a6f

		changedProperty = IsHidden

