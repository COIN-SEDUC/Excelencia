	measure 'Cor Alunos Qualidade Enturmamento (fonts)' = ```
			-- mesma estrutura para (background)
			VAR _Valor =
			    [Demanda e coleta: qualidade do enturmamento]
			
			VAR _Tipo =
			    LOOKUPVALUE(
			        'Regras Indicadores'[Tipo],
			        'Regras Indicadores'[Indicador], 5
			    )
			
			VAR _Meta =
			    SELECTEDVALUE('excelencia_objetivo'[qualidade_entur])
			
			VAR _Atingimento =
			    SWITCH(
			        TRUE(),
			        _Tipo = "MAIOR", DIVIDE(_Valor, _Meta),
			        _Tipo = "MENOR", DIVIDE(_Meta, _Valor)
			    )
			
			RETURN
			    IF(
			        ISINSCOPE(excelencias[NM_ESCOLA]),
			        BLANK(),
			        SWITCH(
			            TRUE(),
			            ISBLANK(_Valor) || ISBLANK(_Meta) , BLANK(),
			            _Atingimento >= 1,   "#1E4620",
			            _Atingimento >= 0.6, "#5C4A0A",
