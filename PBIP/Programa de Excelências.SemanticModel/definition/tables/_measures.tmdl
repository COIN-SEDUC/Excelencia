	measure 'Censo Escolar: % de divergências na matrícula' = ```
			
			VAR _MatriculasSED =
			    CALCULATE (
			        SUM ( excelencias[TOTAL_MATRICULAS] ),
			        excelencias[TOTAL_MATRICULAS] > 0,
			        excelencias[TOTAL_MATRICULAS_CURRICULAR] > 0
			    )
			 
			VAR _MatriculasCenso =
			    CALCULATE (
			        SUM ( excelencias[TOTAL_MATRICULAS_CURRICULAR] ),
			        excelencias[TOTAL_MATRICULAS] > 0,
			        excelencias[TOTAL_MATRICULAS_CURRICULAR] > 0
			    )
			 
			RETURN
			DIVIDE (
			    _MatriculasCenso - _MatriculasSED,
			    _MatriculasSED,
			    BLANK ()
			)
			
			
			/* VAR _EscolasSelecionadas =
			    VALUES ( excelencias[ESCOLA_CD_ESCOLA] )
			VAR _MatriculasSED =
			    CALCULATE (
			        SUMX (
			            VALUES ( sed_congelado_maio_26[COD_ESC] ),
			            CALCULATE ( MAX ( sed_congelado_maio_26[total_matriculas] ) )
			        ),
			        TREATAS ( _EscolasSelecionadas, sed_congelado_maio_26[COD_ESC] )
			    )
			VAR _MatriculasCenso =
			    CALCULATE (
			        SUMX (
			            VALUES ( censo_escolar_coleta[cd_cie] ),
			            CALCULATE ( MAX ( censo_escolar_coleta[total_matriculas_curricular] ) )
			        ),
			        TREATAS ( _EscolasSelecionadas, censo_escolar_coleta[cd_cie] )
			    )
			RETURN
			IF (
			    ISBLANK ( _MatriculasSED ) ||
			    ISBLANK ( _MatriculasCenso ) ||
			    _MatriculasSED = 0,
			    BLANK (),
			    DIVIDE (
			        ABS ( _MatriculasSED - _MatriculasCenso ),
			        _MatriculasSED
			    )
			) */
			```
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Métricas\Censo e Precisão de Dados
		lineageTag: 676db2c3-a06c-41d4-9b0d-f393c620149d

		changedProperty = IsHidden

