table _measures
	lineageTag: 77fbff27-27fd-4b6f-a920-99be3d08af1d

	measure 'Qtd. de alunos projetados no EM Noturno' =
			
			VAR _01 = SUM(excelencias[QT_ALUNOS_NOTURNO])
			VAR _02 = SUM(excelencias[QTD_ALUNO_ENS_MEDIO])
			
			RETURN
			    DIVIDE(
			        _01,
			        _02,
			        BLANK()
			    )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Métricas\Otimização da Rede Escolar
		lineageTag: 5e7925c3-e1a2-4adc-80e7-5f6a87dc5ae5

		changedProperty = IsHidden

	measure 'Qtd. de alunos projetados no PEI' =
			
			VAR _01 = SUM(excelencias[QT_ALUNOS_PEI])
			VAR _02 = SUM(excelencias[TT_ALUNOS])
			
			RETURN
			DIVIDE(
			    _01,
			    _02,
			    BLANK()
			)
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Métricas\Otimização da Rede Escolar
		lineageTag: 48a92e81-9ec9-4535-a221-59216addf636

