	measure 'Debug Combinado' =
			
			VAR _ordem = SELECTEDVALUE(parametro_metricas[parametro_meta Order])
			VAR _Valor = SELECTEDVALUE(parametro_metricas[parametro_meta Fields])
			VAR _Tipo  = LOOKUPVALUE('Regras Indicadores'[Tipo], 'Regras Indicadores'[Indicador], _ordem)
			VAR _Meta  =
			    SWITCH(
			        _ordem,
			        0,  SELECTEDVALUE(excelencia_objetivo[escolas]),
			        1,  SELECTEDVALUE(excelencia_objetivo[alunos_noturnos]),
			        2,  SELECTEDVALUE(excelencia_objetivo[alunos_pei]),
			        3,  SELECTEDVALUE(excelencia_objetivo[salas_aula]),
			        4,  SELECTEDVALUE(excelencia_objetivo[alunos_pendentes]),
			        5,  SELECTEDVALUE(excelencia_objetivo[qualidade_entur]),
			        6,  SELECTEDVALUE(excelencia_objetivo[rendimento]),
			        7,  SELECTEDVALUE(excelencia_objetivo[fechamento]),
			        8,  SELECTEDVALUE(excelencia_objetivo[bolsa_percent_nao_informado]),
			        9,  SELECTEDVALUE(excelencia_objetivo[diverg_matricula]),
			        10, SELECTEDVALUE(excelencia_objetivo[diverg_rendimento]),
			        11, SELECTEDVALUE(excelencia_objetivo[cadastro_escola]),
			        12, SELECTEDVALUE(excelencia_objetivo[cadastro_aluno])
			    )
			RETURN
			    "ordem=" & _ordem &
			    " | valor=" & FORMAT(_Valor, "0.00") &
			    " | tipo=" & _Tipo &
			    " | meta=" & FORMAT(_Meta, "0.00")
