	measure 'Valor Indicador' =
			VAR _Ordem =
			    SELECTEDVALUE ( 'Painel de Excelência'[Ordem Indicador] )
			VAR _Valor =
			    [Valor Indicador Numérico]
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( _Valor ), BLANK (),
			        _Ordem IN { 0, 3 }, FORMAT ( _Valor, "#,##0", "pt-BR" ),
			        FORMAT ( _Valor, "0.00%", "pt-BR" )
			    )
		lineageTag: 148aeab8-c56f-4ca8-a210-9baf2d6a569d

		changedProperty = IsHidden

	measure 'Valor Indicador Numérico' =
			VAR _Ordem =
			    SELECTEDVALUE ( 'Painel de Excelência'[Ordem Indicador] )
			RETURN
			    SWITCH (
			        _Ordem,
			        0,  [Total de Escolas],
			        1,  [Qtd. de alunos projetados no EM Noturno],
			        2,  [Qtd. de alunos projetados no PEI],
			        3,  [Qtd. de salas de aula nas escolas existentes],
			        4,  [% matrículas pendentes],
			        5,  [Demanda e coleta: qualidade do enturmamento],
			        6,  [Rendimento: turmas lançadas dentro do prazo],
			        7,  [Fechamento: turmas lançadas dentro do prazo],
			        8,  [Bolsa Família: % de não informados],
			        9,  [Censo Escolar: % de divergências na matrícula],
			        10, [Censo Escolar: % de divergência na taxa de aprovação],
			        11, [Cadastro de Escolas: % de cadastros inválidos],
			        12, [Cadastro de Alunos: % de cadastros inválidos],
			        BLANK ()
			    )
		displayFolder: Auxiliares
		lineageTag: d1b2d5f7-e775-4889-aa5f-5f674296c8fb

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Link Indicador' =
			
			VAR _Ordem =
			    SELECTEDMEASURE()
			RETURN
			    SWITCH (
			        _Ordem,
			        --0,  --[Total de Escolas],
			        --1,  --[Qtd. de alunos projetados no EM Noturno],
			        --2,  --[Qtd. de alunos projetados no PEI],
			        [Qtd. de salas de aula nas escolas existentes],  "https://hubinteligenciaegestao.educacao.sp.gov.br/Dashboard/Dash?ano=2026&id=86", --[Qtd. de salas de aula nas escolas existentes],
			        4,  "https://hubinteligenciaegestao.educacao.sp.gov.br/Dashboard/Dash?ano=2026&id=108", --[% matrículas pendentes],
			        5,  "https://hubinteligenciaegestao.educacao.sp.gov.br/Dashboard/Dash?ano=2026&id=92", --[Demanda e coleta: qualidade do enturmamento],
			        6,  "https://hubinteligenciaegestao.educacao.sp.gov.br/Dashboard/Dash?ano=2026&id=56", --[Rendimento: turmas lançadas dentro do prazo],
			        7,  "https://hubinteligenciaegestao.educacao.sp.gov.br/Dashboard/Dash?ano=2026&id=54", --[Fechamento: turmas lançadas dentro do prazo],
			        8,  "https://hubinteligenciaegestao.educacao.sp.gov.br/Dashboard/Dash?ano=2026&id=51", --[Bolsa Família: % de não informados],
			        --9,  --[Censo Escolar: % de divergências na matrícula],
			        --10, --[Censo Escolar: % de divergência na taxa de aprovação],
			        --11, --[Cadastro de Escolas: % de cadastros inválidos],
			        --12, --[Cadastro de Alunos: % de cadastros inválidos],
			        BLANK ()
			    )
		displayFolder: Auxiliares
		lineageTag: e233039c-746f-44c6-9d98-677a112cc574

		changedProperty = IsHidden

	measure 'Cor Alunos Noturnos (fonts)' = ```
			-- mesma estrutura para (background)
			VAR _Valor =
			    [Qtd. de alunos projetados no EM Noturno]
			
			VAR _Tipo =
			    LOOKUPVALUE(
			        'Regras Indicadores'[Tipo],
			        'Regras Indicadores'[Indicador], 1
			    )
			
			VAR _Meta =
			    SELECTEDVALUE('excelencia_objetivo'[alunos_noturnos])
			
			VAR _Atingimento =
			    SWITCH(
			        TRUE(),
			        _Tipo = "MAIOR", DIVIDE(_Valor, _Meta),
			        _Tipo = "MENOR", DIVIDE(_Meta, _Valor)
			    )
			
			RETURN
			    IF(
			        ISINSCOPE(excelencias[NM_ESCOLA]),
			        BLANK(),
			        SWITCH(
			            TRUE(),
			            ISBLANK(_Valor) || ISBLANK(_Meta) , BLANK(),
			            _Atingimento >= 1,   "#1E4620",
			            _Atingimento >= 0.6, "#5C4A0A",
			            "#5C1A12"
			        )
			    )
			
			//-------------------------------------------------------------------------------------------------------------------------//
			/*   background          
			    _Atingimento >= 1,   "#F3F8F2",
			    _Atingimento >= 0.6, "#FDFAEF",
			    "#FFF6F5"     
			*/
			```
		displayFolder: Formatação\Cores
		lineageTag: bdc41ba4-db52-45d2-b947-f626f84f62af

		changedProperty = IsHidden

