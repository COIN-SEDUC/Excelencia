	partition 'Regras Indicadores' = calculated
		mode: import
		source = ```
				--regras utilizadas nas fórmulas de formatação condicional da tabela principal
				DATATABLE(
				    "Indicador", INTEGER,
				    "Tipo", STRING,
				    "Formato", STRING,
				    {
				        {0,  "MAIOR","#,##0"},  -- Total de Escolas
				        {1,  "MENOR","0.0%"},   -- Qtd. de alunos projetados no EM Noturno
				        {2,  "MAIOR","0.0%"},   -- Qtd. de alunos projetados no PEI
				        {3,  "MAIOR","#,##0"},   -- Qtd. de salas de aula nas escolas existentes        
				        {4,  "MENOR","0.0%"},   -- % matrículas pendentes
				        {5,  "MENOR","0.0%"},   -- Demanda e coleta: qualidade do enturmamento
				        {6,  "MAIOR","0.0%"},   -- Rendimento: turmas lançadas dentro do prazo
				        {7,  "MAIOR","0.0%"},   -- Fechamento: turmas lançadas dentro do prazo
				        {8,  "MENOR","0.0%"},   -- Bolsa Família: % de não informados
				        {9,  "MENOR","0.0%"},   -- Censo Escolar: % de divergências na matrícula
				        {10, "MENOR","0.0%"},   -- Censo Escolar: % de divergência na taxa de aprovação
				        {11, "MENOR","0.0%"},   -- Cadastro de Escolas: % de cadastros inválidos
				        {12, "MENOR","0.0%"}   -- Cadastro de Alunos: % de cadastros inválidos
				    }
				)
				
				/* 
				 Regras definidas para as cores: 
				
				-Noturno: Vermelho são percentuais maiores, verde percentuais menores
				-PEI: Vermelho são percentuais menores, verde percentuais maiores
				-Pendentes: Vermelho são percentuais maiores, verde percentuais menores
				-Qualidade Enturmamento: Vermelho são percentuais maiores, verde percentuais menores
				-Rendimento/Fechamento: Vermelho são percentuais menores, verde percentuais maiores (mais perto de 100%)
				-Não info Bolsa Família: Vermelho são percentuais maiores, verde percentuais menores
				
				 */
				```

	annotation PBI_Id = 179f30b273cc45a5926da667e5d3f789

